FROM soyoung-registry-vpc.cn-beijing.cr.aliyuncs.com/sy-system/exec-go:1.22-bullseye AS builder
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY internal/assets ./internal/assets
COPY internal/nvrlab ./internal/nvrlab
COPY internal/nvrsnapshot ./internal/nvrsnapshot
COPY internal/resourceview ./internal/resourceview
COPY cmd/nvr-snapshot-backfill ./cmd/nvr-snapshot-backfill
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -trimpath -ldflags='-s -w' -o /out/nvr-snapshot-backfill ./cmd/nvr-snapshot-backfill
FROM debian:bullseye-slim
RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg ca-certificates && rm -rf /var/lib/apt/lists/*
COPY --from=builder /out/nvr-snapshot-backfill /usr/local/bin/nvr-snapshot-backfill
ENTRYPOINT ["/usr/local/bin/nvr-snapshot-backfill"]
